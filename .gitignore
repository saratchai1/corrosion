# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*

# OS/editor
.DS_Store
.vscode/
.idea/

# Geospatial working files
.cache/
cache/
tmp/
temp/
working/
*.aux.xml
*.ovr
*.vrt

# Full-scene/raw downloads must never be committed
raw/
full_scenes/

# AOI COGs are local in v1 until authenticated Git LFS quota is verified
data/satellite/**/*.tif
data/satellite/**/*.tiff
data/processed/**/*.tif
data/processed/**/*.tiff

# Local frontend dependencies/build output
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Per-acquisition QA previews generated during the bounded MVP download.
# Optimized per-epoch WebP previews are committed under data/processed/web.
data/previews/landsat/1987/
data/previews/landsat/1990/
data/previews/landsat/2000/
data/previews/landsat/2010/

# Secrets
*.pem
*.key
credentials*
tokens*
